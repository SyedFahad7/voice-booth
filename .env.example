# Copy to .env and fill in. .env is never committed.

# Your ElevenLabs API key. If it's missing here, the booth also looks in the .env of the
# projects next to this folder.
ELEVENLABS_API_KEY=

# Optional: a specific ffmpeg binary. Otherwise the booth uses ffmpeg on PATH, the one inside a
# Remotion project next to this folder, or the one `npm install` brings.
# FFMPEG_PATH=

# Optional: where the Test Impact Remotion project lives (defaults to ../test-impact-video).
# TEST_IMPACT_DIR=

# Hosted booth only (set these on Vercel too). The shared sign-in password, and a private
# Cloudflare R2 bucket with an Object Read & Write API token. The local tools that publish
# projects and bring picks back read the R2 values from this file.
# BOOTH_PASSWORD=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=voice-booth
