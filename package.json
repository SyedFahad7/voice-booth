{
  "name": "voice-booth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Try ElevenLabs voices, pauses and music on a finished video without re-rendering it.",
  "repository": "github:SyedFahad7/voice-booth",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tools/selftest.mjs",
    "list": "node adapters/test-impact.mjs list",
    "bed": "node adapters/test-impact.mjs bed",
    "music": "node tools/music-library.mjs list",
    "music:starter": "node tools/music-library.mjs starter",
    "music:verify": "node tools/music-library.mjs verify --scribe",
    "publish": "node tools/publish.mjs",
    "picks": "node tools/picks.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "allowScripts": {
    "ffmpeg-static": true
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "aws4fetch": "^1.0.20",
    "ffmpeg-static": "^5.3.0"
  }
}
